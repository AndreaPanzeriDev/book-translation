APP_NAME="Book Translation Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Porta pubblicata su 127.0.0.1 per l'applicazione Laravel.
# setup.sh verifica che sia libera e, se occupata, ne propone un'altra.
APP_PORT=8000
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=book_translation
DB_USERNAME=book_translation
# MariaDB applica queste credenziali solo alla prima creazione del volume
# db-data: se le modifichi dopo, rilancia ./setup.sh --reset.
DB_PASSWORD=change_me

# Porta pubblicata su 127.0.0.1 per collegarsi a MariaDB da un client esterno
# (DBeaver, TablePlus, ...). Non è usata dall'applicazione, che usa DB_PORT.
DB_EXTERNAL_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Timeout in secondi per le richieste ai provider AI.
# I modelli locali possono richiedere molto tempo al primo caricamento.
AI_CONNECT_TIMEOUT=15
AI_REQUEST_TIMEOUT=300

# Porta pubblicata su 127.0.0.1 per il server di sviluppo Vite (HMR).
# setup.sh verifica che sia libera e, se occupata, ne propone un'altra.
VITE_PORT=5173

VITE_APP_NAME="${APP_NAME}"
